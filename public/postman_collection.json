{
  "info": {
    "_postman_id": "7b587d55-6688-4c19-94b3-d2d7938fe710",
    "name": "IRCTC Real-Time API Engine",
    "description": "Postman Collection for Indian Railways real-time developer API. Includes live PNR checks, 14-day seat availability calendar forecast, post-charting vacant berths, real-time train fare breakup, and live satellite GPS train running status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.irctc.dev",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "dummy_api_key_replace_with_your_own",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Status code is 200 OK\", function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test(\"Response time is acceptable (< 1500ms)\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(1500);",
          "});",
          "",
          "pm.test(\"Response is valid JSON object\", function () {",
          "    pm.response.to.be.json;",
          "    const data = pm.response.json();",
          "    pm.expect(data).to.be.an('object');",
          "});",
          "",
          "pm.test(\"Success flag is true\", function () {",
          "    const data = pm.response.json();",
          "    pm.expect(data.success !== false).to.be.true;",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Availability & Pricing",
      "item": [
        {
          "name": "14-Day Seat Availability Forecast",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trains/12557/availability?from=NKE&to=ANVT&date=17-11-2026&class=3A&quota=GN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trains", "12557", "availability"],
              "query": [
                { "key": "from", "value": "NKE", "description": "Origin Station Code" },
                { "key": "to", "value": "ANVT", "description": "Destination Station Code" },
                { "key": "date", "value": "17-11-2026", "description": "Journey date DD-MM-YYYY" },
                { "key": "class", "value": "3A", "description": "Travel class (1A, 2A, 3A, 3E, SL)" },
                { "key": "quota", "value": "GN", "description": "Quota (GN, TQ, PT, LD)" }
              ]
            },
            "description": "Fetch real-time PRS seat & berth availability across classes and quotas with 14-day calendar forecast."
          }
        },
        {
          "name": "Vacant Berths After Chart Preparation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trains/12557/chart-vacant?boardingStation=GKP&class=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trains", "12557", "chart-vacant"],
              "query": [
                { "key": "boardingStation", "value": "GKP", "description": "Boarding Station Code" },
                { "key": "class", "value": "ALL", "description": "Class filter (ALL, 1A, 2A, 3A, 3E, SL)" }
              ]
            },
            "description": "Query real-time post-charting vacant berths from online reservation charts for Current Booking & TTE allotment."
          }
        },
        {
          "name": "Train Ticket Fare Breakup",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trains/12558/fare?from=ANVT&to=NKE&class=all&quota=GN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trains", "12558", "fare"],
              "query": [
                { "key": "from", "value": "ANVT", "description": "Origin station" },
                { "key": "to", "value": "NKE", "description": "Destination station" },
                { "key": "class", "value": "all", "description": "Class (1A, 2A, 3A, 3E, SL, or all)" },
                { "key": "quota", "value": "GN", "description": "Quota (GN, TQ)" }
              ]
            },
            "description": "Fetch real-time train ticket fare breakup (Base, Reservation, Superfast, GST, Catering)."
          }
        }
      ]
    },
    {
      "name": "Live Tracking & Telemetry",
      "item": [
